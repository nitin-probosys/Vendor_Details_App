<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:html="http://www.w3.org/1999/xhtml">
    <Dialog id="pdfDialog" title="PDF Preview" contentWidth="95%" stretch="true" contentHeight="90%" afterOpen=".onDialogAfterOpen">
        <content>
            <html:div style="width: 100%; height: 600px; position: relative; background: #f0f0f0;">                <!-- PDF Viewer -->
                <html:iframe id="pdfIframe" width="100%" height="100%" style="border: none; background: #ffffff;" src="about:blank" />
            </html:div>
        </content>
        <beginButton>
            <Button text="Download PDF" press="onDownloadPDF" />
        </beginButton>
        <endButton>
            <Button text="Close" press="onClosePDF" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>